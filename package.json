{
  "name": "dsh-plugin-provider-label",
  "version": "0.3.0",
  "description": "Show the provider's display name next to the model name in the DeepSeek Harness composer picker, with a configurable colour per provider",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "provider",
    "model-picker"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poyarkoff/dsh-plugins.provider-label.git"
  },
  "homepage": "https://github.com/poyarkoff/dsh-plugins.provider-label#readme"
}
